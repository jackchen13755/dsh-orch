{
  "name": "@dsh-external/dsh-orch",
  "version": "0.6.2",
  "description": "异步多席位智能体编排器：派发不阻塞、可中途 steer 改方向、结果异步回灌调用方会话",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "BSD-3-Clause",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "orchestrator",
    "agents"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc <2",
    "@deepseek-ai/schemastery": ">=3.18 <4"
  },
  "scripts": {
    "check": "bash scripts/build.sh",
    "smoke": "node scripts/smoke.mjs",
    "heal": "bash scripts/heal-env.sh",
    "postinstall": "bash scripts/heal-env.sh"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  }
}
